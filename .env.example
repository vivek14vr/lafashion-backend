DATABASE_URL=mongodb://127.0.0.1:27017/event-sharon
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Used only by `npm run seed:admin`; choose a strong password and do not commit it.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Public website
FRONTEND_URL=http://localhost:3000
# Admin cookie / CSRF origin — use the URL where /admin is opened in the browser
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# This Payload app (for CORS allowlist)
PAYLOAD_BACKEND_URL=http://127.0.0.1:3001
# Set true when the public frontend uses HTTPS; false for local HTTP.
AUTH_COOKIE_SECURE=false
# Optional; only set when sharing cookies across subdomains.
# AUTH_COOKIE_DOMAIN=.lafashioncloset.com

# Private S3 media storage. On EC2, use the attached IAM role; do not add keys here.
S3_BUCKET=lafashioncloset-media
S3_REGION=us-east-2
S3_PREFIX=lafashioncloset

# --- Render production example ---
# FRONTEND_URL=https://lafashion-frontend.onrender.com
# NEXT_PUBLIC_SERVER_URL=https://lafashion-frontend.onrender.com
# PAYLOAD_BACKEND_URL=https://lafashion-backend.onrender.com
